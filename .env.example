# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key for AI match analysis (Claude Sonnet 4.6)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Symmetric encryption key for EOS auth tokens stored in the DB.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# ── Production ────────────────────────────────────────────────────────────────

# Set to "true" behind HTTPS to enable the Secure cookie flag + HSTS header
SECURE_COOKIES=false

# Comma-separated allowed origins for CORS (leave blank in dev to allow all)
# Example: ALLOWED_ORIGINS=https://rlcoach.yourdomain.com
ALLOWED_ORIGINS=

# Per-type daily AI caps and plan-cycle gating (defaults shown).
MATCH_DAILY_LIMIT=1     # match analyses per user per day
SERIES_DAILY_LIMIT=1    # series analyses per user per day
PLAN_MAX_REGENS=1       # plan regenerates allowed per plan cycle
# Legacy shared cap (no longer gates match/series, kept for reference)
DAILY_ANALYSIS_LIMIT=5

# Canonical public origin for OAuth/OpenID realm + return_to (Steam sign-in).
# Defaults to the first ALLOWED_ORIGINS entry; set explicitly if needed.
# PUBLIC_BASE_URL=https://whatasave.xyz

# ── Optional: override Epic/EOS client credentials ────────────────────────────
# These default to the standard Rocket League client values.
# Only set these if you have been issued your own credentials.
# EGS_CLIENT_ID=
# EGS_CLIENT_SECRET=
# EOS_CLIENT_ID=
# EOS_AUTH_HEADER=
# EOS_DEPLOYMENT_ID=
